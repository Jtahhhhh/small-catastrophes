   "lines": [
    {
     "text": "And in January 2022, an undersea volcano erupted near Tonga.",
     "source": "AP via NPR (2022)"
    },
    {
     "text": "It severed the single cable connecting the country to the internet.",
     "source": "AP via NPR; Euronews (2022)"
    }
