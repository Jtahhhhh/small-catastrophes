   "lines": [
    {
     "text": "A few months later, in February 2022, protesters blocked the Ambassador Bridge between Detroit and Windsor for six days.",
     "source": "Reuters (2022)"
    },
    {
     "text": "That one bridge carries about a quarter of all the goods trade between the U.S. and Canada.",
     "source": "Reuters (2022)"
    }
