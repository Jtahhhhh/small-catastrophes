   "lines": [
    {
     "text": "Across town, people start trading. A haircut for a casserole. Lawn mowing for a ride."
    },
    {
     "text": "Economists call this barter."
    },
    {
     "text": "It's slow, it's awkward, and it only works if you each want what the other one has."
    }
